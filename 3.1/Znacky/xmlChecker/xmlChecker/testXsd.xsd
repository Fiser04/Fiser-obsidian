<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- ============ root element ============ -->
    <xs:element name="app-config">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server"   type="serverType"/>
                <xs:element name="database" type="databaseType"/>
                <xs:element name="features" type="featuresType"/>
                <xs:element name="logging"  type="loggingType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ============ server ============ -->
    <xs:complexType name="serverType">
        <xs:attribute name="host"  type="xs:string" use="required"/>
        <xs:attribute name="port"  type="xs:int"    use="required"/>
        <xs:attribute name="debug" type="xs:boolean" default="false"/>
    </xs:complexType>

    <!-- ============ database ============ -->
    <xs:complexType name="databaseType">
        <xs:sequence>
            <xs:element name="url"       type="xs:string"/>
            <xs:element name="username"  type="xs:string"/>
            <xs:element name="password"  type="xs:string"/>
            <xs:element name="pool-size" type="xs:positiveInteger"/>
        </xs:sequence>
        <xs:attribute name="driver" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="postgresql"/>
                    <xs:enumeration value="mysql"/>
                    <xs:enumeration value="sqlite"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>

    <!-- ============ features ============ -->
    <xs:complexType name="featuresType">
        <xs:sequence>
            <xs:element name="feature" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:attribute name="name"    type="xs:string"  use="required"/>
                    <xs:attribute name="enabled" type="xs:boolean" use="required"/>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ============ logging ============ -->
    <xs:complexType name="loggingType">
        <xs:attribute name="level" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="DEBUG"/>
                    <xs:enumeration value="INFO"/>
                    <xs:enumeration value="WARN"/>
                    <xs:enumeration value="ERROR"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="file" type="xs:string" use="optional"/>
    </xs:complexType>

</xs:schema>
