
<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

<xsl:template match="/">
  <html>
      <head>
          <meta charset="UTF-8"/>
          <title>Katalog</title>
      </head>
      <body>
          <h1><xsl:value-of select="katalog/info/Firma"/></h1>
          <table border="1">
              <thead>
                  <tr>
                      <th>Název</th>
                      <th>Kategorie</th>
                      <th>Cena</th>
                      <th>Popis</th>
                  </tr>
              </thead>
              <tbody>
                  <xsl:apply-templates select="katalog/polozka"/>
              </tbody>
          </table>
      </body>
  </html>
</xsl:template>

<xsl:template match="polozka">
    <tr>
        <xsl:apply-templates select="nazev|kategorie|cena|popis"/>
    </tr>
</xsl:template>

<xsl:template match="nazev">
    <th scope="row"><xsl:value-of select="."/></th>
</xsl:template>

<xsl:template match="kategorie">
    <td><xsl:value-of select="."/></td>
</xsl:template>

<xsl:template match="cena">
    <td><xsl:value-of select="."/> <xsl:value-of select="/katalog/info/mena"/></td>
</xsl:template>

<xsl:template match="popis">
    <td><xsl:value-of select="dulezite"/></td>
</xsl:template>

</xsl:stylesheet>
